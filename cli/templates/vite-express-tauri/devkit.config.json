{
  "$schema": "https://raw.githubusercontent.com/Roboticela/DevKit/main/cli/schemas/devkit-config.json",
  "devkit": "2.0",
  "template": "vite-express-tauri",
  "project": { "id": null, "installationId": null },
  "site": {
    "name": "{{SITE_NAME}}",
    "url": "{{SITE_URL}}",
    "description": "{{SITE_DESCRIPTION}}"
  },
  "theme": {
    "preset": "default",
    "colors": { "primary": "#0e7aff", "secondary": "#86868b" },
    "radius": "balanced",
    "darkMode": true,
    "darkModeStrategy": "class"
  }
}

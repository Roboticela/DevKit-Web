{
  "name": "devkit",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "devkit": "concurrently -k -n server,cli -c cyan,magenta \"npm run devkit:server\" \"npm run devkit:cli\"",
    "devkit:server": "npm run dev --prefix server",
    "devkit:cli": "npm run dev:watch --prefix cli",
    "try": "node scripts/local-devkit.mjs",
    "devkit-test:setup": "node scripts/local-devkit.mjs"
  },
  "dependencies": {
    "next": "16.3.3",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-easy-crop": "^6.2.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "concurrently": "^9.2.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
